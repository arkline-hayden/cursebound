{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/server/src/**/*.ts",
    "apps/server/test/**/*.ts",
    "apps/cloud/src/**/*.ts",
    "apps/cloud/test/**/*.ts",
    "tools/*/src/**/*.ts",
    "tests/**/*.ts"
  ]
}
